# Claude API key. Leave unset to use the offline rule-based reader.
ANTHROPIC_API_KEY=
# Force an engine: "claude" or "heuristic"
# AI_ENGINE=
# CLAUDE_MODEL=claude-opus-5-5
PORT=3001
DATA_FILE=./data/db.json
# Domain for personal forwarding addresses (anna-7k3p2q@in.lifeadmin.ie)
INBOX_DOMAIN=in.lifeadmin.ie
# Shared secret your email provider sends as the X-Inbound-Secret header
INBOUND_SECRET=change-me

# --- Hosting (Vercel) ---
# Postgres connection string (set automatically when you add Neon in Vercel → Storage)
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Protects /api/cron/* (Vercel sends it as a Bearer token)
# CRON_SECRET=some-long-random-string
# Optional: extra gigs in Free time
# TICKETMASTER_API_KEY=
