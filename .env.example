# Claude API key. Leave unset to use the offline rule-based reader.
ANTHROPIC_API_KEY=
# Force an engine: "claude" or "heuristic"
# AI_ENGINE=
# CLAUDE_MODEL=claude-opus-5-5
PORT=3001
DATA_FILE=./data/db.json
# Domain for personal forwarding addresses (anna-7k3p2q@in.lifeadmin.ie)
INBOX_DOMAIN=in.lifeadmin.ie
# Shared secret your email provider sends as the X-Inbound-Secret header
INBOUND_SECRET=change-me

# --- Hosting (Vercel) ---
# Postgres connection string (set automatically when you add Neon in Vercel → Storage)
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Protects /api/cron/* (Vercel sends it as a Bearer token)
# CRON_SECRET=some-long-random-string
# Optional: extra gigs in Free time
# TICKETMASTER_API_KEY=
# Optional: gigs, club nights and comedy from Skiddle (free key from skiddle.com/api)
# SKIDDLE_API_KEY=

# --- Hosting (Netlify + Supabase) ---
# Supabase transaction pooler URL, signed in as the app's own role (see README)
# DATABASE_URL=postgresql://lifeadmin_app.<project-ref>:<password>@aws-<n>-eu-west-1.pooler.supabase.com:6543/postgres
# CA certificate (PEM) for non-Supabase hosts; Supabase's is bundled in server/certs
# DATABASE_CA_CERT=
# Schema for the app's tables (default lifeadmin)
# DATABASE_SCHEMA=lifeadmin
